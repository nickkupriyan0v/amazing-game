ARG NODE_VERSION=22
FROM node:${NODE_VERSION}-bookworm AS builder
WORKDIR /app

# 1️⃣ Копируем корневые package.json, yarn.lock и lerna.json
COPY package.json yarn.lock lerna.json ./

# 2️⃣ Копируем package.json всех пакетов
COPY packages/*/package.json ./packages/

# 3️⃣ Устанавливаем все зависимости (включая devDependencies)
RUN yarn install --frozen-lockfile

# 4️⃣ Копируем весь исходный код
COPY . .

# 5️⃣ Собираем сервер
RUN npx lerna run build --scope @app/server --stream


# --- Stage 2: Runtime ---
FROM node:${NODE_VERSION}-bookworm AS runtime
WORKDIR /app
ENV NODE_ENV=production

# 6️⃣ Копируем только скомпилированный пакет server
COPY --from=builder /app/packages/server ./packages/server

# 7️⃣ Рабочая директория для сервера
WORKDIR /app/packages/server
EXPOSE 3001

# 8️⃣ Запуск сервера
CMD ["node", "dist/index.js"]
