{
  "name": "client",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsc --project tsconfig.server.json && cross-env NODE_ENV=development EXTERNAL_SERVER_URL='http://localhost:3001' INTERNAL_SERVER_URL='http://localhost:3001' node dist-server/server.js vite",
    "build": "npm run build-client && npm run build-ssr && npm run build-server",
    "build-client": "vite build --outDir dist",
    "build-ssr": "vite build --ssr ./src/entry-server.tsx --outDir ./dist/server",
    "build-server": "tsc -p tsconfig.server.json",
    "preview": "node server/index.js"
  },
  "dependencies": {
    "@chakra-ui/react": "^3.29.0",
    "@emotion/react": "^11.14.0",
    "@supabase/supabase-js": "^2.84.0",
    "compression": "^1.8.1",
    "@reduxjs/toolkit": "^2.10.1",
    "dotenv": "^16.0.2",
    "eslint-config-prettier": "^8.5.0",
    "prettier": "^2.7.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.66.1",
    "react-icons": "^5.5.0",
    "react-redux": "^9.2.0",
    "react-router": "^7.9.4",
    "react-router-dom": "^7.9.6",
    "serialize-javascript": "^7.0.0",
    "sirv": "^3.0.2"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/react-hooks": "^8.0.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/compression": "^1.8.1",
    "@types/jest": "29.5.5",
    "@types/react": "^18.0.17",
    "@types/react-dom": "^18.0.6",
    "@types/react-router-dom": "^5.3.3",
    "@types/serialize-javascript": "^5.0.4",
    "@typescript-eslint/eslint-plugin": "^5.35.1",
    "@typescript-eslint/parser": "^5.35.1",
    "@vitejs/plugin-react": "^2.0.1",
    "cross-env": "^7.0.3",
    "eslint": "^8.23.0",
    "identity-obj-proxy": "3.0.0",
    "jest": "29.6.2",
    "jest-environment-jsdom": "29.6.2",
    "lefthook": "^1.3.9",
    "prettier": "^2.7.1",
    "ts-jest": "29.1.1",
    "typescript": "^4.8.2",
    "vite": "^3.0.7"
  },
  "license": "MIT"
}
